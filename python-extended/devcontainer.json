{
  "name": "AppSolve Fusion - ROCSII",
  "dockerComposeFile": "docker-compose.yml",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.2": {
      "moby": "false"
    },
    "ghcr.io/devcontainers/features/common-utils:2.7.0": {},
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "version": "lts"
    }
  },
  "service": "app",
  "customizations": {
    "vscode": {
      "settings": {
        "workbench.iconTheme": "material-icon-theme",
        "git.openRepositoryInParentFolders": "always",
        "dev.containers.mountWaylandSocket": false
      },
      "extensions": [
        "EditorConfig.EditorConfig",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "PKief.material-icon-theme",
        "esbenp.prettier-vscode",
        "ms-mssql.mssql",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-mssql.sql-database-projects-vscode",
        "rangav.vscode-thunder-client",
        "mhutchie.git-graph",
        "Anthropic.claude-code"
      ]
    }
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "postCreateCommand": "sudo chown -R vscode:vscode ${containerWorkspaceFolder}",
  "postStartCommand": "git config --global --add safe.directory ${containerWorkspaceFolder} && git config credential.useHttpPath true",
  "mounts": [
    "source=/q/projects/,target=/external,type=bind"
  ]
}
